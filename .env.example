# Copy these names into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Supabase (meal-plan-sync project) — Settings → API
SUPABASE_URL=https://xmwozksnvzhxczczhzjd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Massive (formerly Polygon.io) — free Stocks Basic key
MASSIVE_API_KEY=
# MASSIVE_BASE_URL=https://api.massive.com

# Alpaca paper account (options data, indicative feed)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# App login password (single user) and cookie-signing secret (any long random string)
APP_PASSWORD=
SESSION_SECRET=

# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" on cron calls
CRON_SECRET=

# Web Push (generate once: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
