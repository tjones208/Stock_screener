# Copy these names into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Supabase (meal-plan-sync project) — Settings → API
SUPABASE_URL=https://xmwozksnvzhxczczhzjd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Massive (formerly Polygon.io) — free Stocks Basic key
MASSIVE_API_KEY=
# MASSIVE_BASE_URL=https://api.massive.com

# Alpaca paper account (options data, indicative feed)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# App login password (single user)
APP_PASSWORD=

# Optional overrides — not needed. By default the app derives its session key from
# SUPABASE_SERVICE_ROLE_KEY, and keeps the cron token and Web Push keys in the
# Supabase table ss_app_secrets (created by migration 0003, service-role only).
# SESSION_SECRET=
# CRON_SECRET=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
